# Copy this file to .env and fill in ONE key. Never commit .env.
# Without a key SemantiCI still works, using schema rules instead of an LLM.

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Or any OpenAI-compatible API
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: override the model name
# SEMANTICI_LLM_MODEL=gemini-3.6-flash
